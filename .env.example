# ==============================================================================
# TEAM BATTLE ANGELS - AGENT X ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and insert your API keys:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/macOS)
# ==============================================================================

# --- LLM API Keys (Provide at least one) ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Default Model Selection ---
# Examples:
#   openai/gpt-4o
#   anthropic/claude-3-5-sonnet-20241022
#   gemini/gemini-1.5-pro
#   ollama/llama3 (for local offline LLMs)
MSWEA_MODEL_NAME=openai/gpt-4o

# --- Agent Limits & Safety (Optional) ---
# Maximum cost in USD per run (0 = unlimited)
MSWEA_COST_LIMIT=3.0

# Silence startup banner if true
MSWEA_SILENT_STARTUP=false

